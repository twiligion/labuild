#!/bin/sh
# labuild launcher: pick a Lua interpreter and point the driver at this tree.
root=$(CDPATH= cd -- "$(dirname -- "$(readlink -f "$0")")/.." && pwd)

LABUILD_ROOT="$root"
LABUILD_EXE="$root/bin/labuild"
LABUILD_CORE="${LABUILD_CORE:-$root/bin/labuild-core}"
LABUILD_SH="${LABUILD_SH:-$root/share/labuild/labuild-sh.sh}"
ABUILD_SHAREDIR="${ABUILD_SHAREDIR:-$root/../share}"
APK="${APK:-$root/bin/apk}"
PATH="$root/src:$root/bin:$PATH"
export LABUILD_ROOT LABUILD_EXE LABUILD_CORE LABUILD_SH ABUILD_SHAREDIR APK PATH

if [ -n "$LABUILD_LUA" ]; then
	exec "$LABUILD_LUA" "$root/lua/labuild.lua" "$@"
fi
for l in luajit lua5.5 lua5.4 lua5.3 lua5.2 lua5.1 lua; do
	if command -v "$l" >/dev/null 2>&1; then
		LABUILD_LUA="$l"
		export LABUILD_LUA
		exec "$l" "$root/share/labuild/labuild.lua" "$@"
	fi
done

echo "labuild: no Lua interpreter found (set LABUILD_LUA)" >&2
exit 1
